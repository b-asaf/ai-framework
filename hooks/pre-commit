#!/bin/sh
# ai-framework git hook launcher (plan step S.7, DEC-027).
#
# hooks/pre-commit, hooks/commit-msg and hooks/pre-push are this same file. It finds the framework
# folder and a working Python 3 and runs execution/verification/hook.py with the hook's own name;
# every check is in Python (message format, the push gate and build-verify).
#
# "aiFramework.root" is a global git setting written by `python setup.py`. If it, or a working
# Python 3, is missing, the hook blocks with a fix message: a gate that cannot run must not pass silently.
#
# Escape hatches for emergencies:
#   git commit --no-verify / git push --no-verify   (skips the hook)
#   SKIP_VERIFICATION=1 git push     (skips the dependency and quick-lane checks)
#   SKIP_DIFF_SIZE_CHECK=1 git push  (diff-size check only)
#   SKIP_BUILD_VERIFY=1 git push     (build-verify only)
#   AI_FRAMEWORK_PYTHON=<path>       (use this interpreter)

HOOK=$(basename "$0")
BYPASS="git commit --no-verify"
[ "$HOOK" = "pre-push" ] && BYPASS="git push --no-verify"

block() {
  echo ""
  echo "BLOCKED $HOOK: $1"
  shift
  for line in "$@"; do
    echo "  $line"
  done
  echo "  Bypass once (reviewed exception only): $BYPASS"
  echo ""
  exit 1
}

runs_python() {
  # Succeeds only if the given command really starts a Python 3. The Windows
  # Store "python3" stub prints a message and exits non-zero, so it never passes.
  "$@" -c 'import sys; sys.exit(0 if sys.version_info[0] == 3 else 1)' >/dev/null 2>&1
}

run_python() {
  if [ "$PYTHON" = "py -3" ]; then
    py -3 "$@"
  else
    "$PYTHON" "$@"
  fi
}

# Git sends the push lines on stdin and they cannot be read twice.
PUSH_INPUT=""
if [ "$HOOK" = "pre-push" ]; then
  PUSH_INPUT=$(cat)
fi

# Local repository variables must not leak into the checks or into the project's own lint and test
# commands (a test that runs git in a temp folder would otherwise act on this repository).
for var in $(git rev-parse --local-env-vars 2>/dev/null); do
  unset "$var"
done

FRAMEWORK_ROOT=$(git config --global --get aiFramework.root 2>/dev/null)
EDGE="execution/verification/hook.py"

if [ -z "$FRAMEWORK_ROOT" ]; then
  block "the ai-framework folder is not configured on this machine." \
    "Fix: run 'python setup.py' in the ai-framework folder," \
    "or: git config --global aiFramework.root <path to the ai-framework folder>"
fi
if [ ! -f "$FRAMEWORK_ROOT/$EDGE" ]; then
  block "gate script not found: $FRAMEWORK_ROOT/$EDGE" \
    "The ai-framework folder was moved or deleted, or it is older than these hooks." \
    "Fix: run 'python setup.py' in its new location, or update the folder."
fi

PYTHON=""
if [ -n "${AI_FRAMEWORK_PYTHON:-}" ]; then
  runs_python "$AI_FRAMEWORK_PYTHON" && PYTHON="$AI_FRAMEWORK_PYTHON"
elif runs_python python; then
  PYTHON="python"
elif runs_python py -3; then
  PYTHON="py -3"
elif runs_python python3; then
  PYTHON="python3"
fi
if [ -z "$PYTHON" ]; then
  block "no working Python 3 found (tried python, py -3, python3)." \
    "Fix: install Python 3 and put it on PATH," \
    "or pin one: export AI_FRAMEWORK_PYTHON=<path to python>"
fi

if [ -n "$PUSH_INPUT" ]; then
  printf '%s\n' "$PUSH_INPUT" | run_python -B "$FRAMEWORK_ROOT/$EDGE" "$HOOK" "$@"
else
  run_python -B "$FRAMEWORK_ROOT/$EDGE" "$HOOK" "$@" < /dev/null
fi
exit $?
